{
  // Worker for specs.neilsriv.tech. Not deployed by tests.
  // Before a deploy, run `node worker/prepare-assets.mjs` so public/style.css
  // and public/vendor-hljs/ exist. Those files are generated and gitignored.
  //
  // Secrets, set with `wrangler secret put` (names only, never values):
  //   ROUTE_SPEC_COMMENTS_WEBHOOK_URL
  //   ROUTE_SPEC_COMMENTS_WEBHOOK_KEY
  //   AGENT_TOKEN_IDS    comma-separated Access service-token common_names
  //   BACKUP_TOKEN_ID    the backup loop's service token common_name (read-only)
  //   ADMIN_TOKEN_ID     the one-time comment-import service token common_name
  //   AGENT_KEY, BACKUP_KEY, ADMIN_KEY   bearer keys, used only when AUTH_MODE is "open"
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mdview",
  "main": "index.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    // Everything but /static/build/* runs the Worker first (Access, CSP, the
    // page). /static/build/ is the hashed build from prepare-assets.mjs, served
    // straight from the asset store with public/_headers' immutable
    // Cache-Control. A path a negative pattern matches never reaches the
    // Worker, so it must cover only files that exist in public/.
    "run_worker_first": ["/*", "!/static/build/*"]
  },
  // The deploy's version id keys the render cache (worker/render-cache.js).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mdview-specs" }],
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "PeanutStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PeanutStore"] }],
  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
  "vars": {
    "PUBLIC_HOST": "specs.neilsriv.tech",
    // "open" until Neil's IdP is ready: no Access JWT, and bearer keys pick
    // agent, backup and admin. An unkeyed request is 401. Do not set
    // ALLOW_ANONYMOUS_HUMAN here: that makes every visitor HUMAN_EMAILS[0],
    // and a forged Origin can then write as them. "access" (the default when
    // AUTH_MODE is unset) checks the Access JWT. Tests run with "access".
    "AUTH_MODE": "open",
    // Placeholder until the Access team name is confirmed.
    "TEAM_DOMAIN": "https://neilsriv.cloudflareaccess.com",
    "POLICY_AUD": "replace-with-access-policy-aud",
    "HUMAN_EMAILS": "neil.srivastava1@gmail.com,neil@neilsriv.tech"
  }
}
